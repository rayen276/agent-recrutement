# Fournisseur : gemini (gratuit, recommandé), groq (gratuit), openrouter, anthropic (payant)
RH_PROVIDER=gemini

# Clé Gemini gratuite, sans carte bancaire : https://aistudio.google.com/apikey
GEMINI_API_KEY=colle-ta-cle-ici

# Autres fournisseurs (utiles seulement si RH_PROVIDER les désigne)
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# Modèle (optionnel). Vérifiez les noms disponibles dans la console du fournisseur.
# RH_MODEL=gemini-3.8-flash

# Réflexion des modèles gpt-oss (Groq) : low | medium | high. Par défaut « low » (réponses plus courtes,
# moins de quota consommé). Videz la valeur ou changez de modèle si le fournisseur la refuse.
# RH_REASONING_EFFORT=low

# --- Envoi d'e-mails de candidature (facultatif) ---------------------------
# Sans cette section, l'agent rédige le brouillon et vous le télécharge en .eml.
# Gmail : activez la validation en 2 étapes, puis créez un « mot de passe d'application »
# (https://myaccount.google.com/apppasswords). N'utilisez pas votre mot de passe habituel.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre.adresse@gmail.com
# SMTP_PASSWORD=mot-de-passe-d-application
# SMTP_FROM=votre.adresse@gmail.com
